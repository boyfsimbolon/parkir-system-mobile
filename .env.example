# =====================================================
# PARKIR SYSTEM - Mobile Getter (Flutter)
# Copy: cp .env.example .env
# Dipakai via --dart-define atau package flutter_dotenv
# =====================================================

# WAJIB: base URL API Next.js
# Android emulator: http://10.0.2.2:3000
# iOS simulator / real device (satu WiFi): http://192.168.1.x:3000
# Production: https://parkir-kamu.vercel.app
API_BASE_URL=http://10.0.2.2:3000

# Prefix QR ticket (harus sama dengan QR_CODE_PREFIX di website)
QR_CODE_PREFIX=PRK

# Kompres foto check-in sebelum upload (pakai nice_image_compress)
# Resolusi dibatasi agar kompres & upload cepat di semua HP
MAX_PHOTO_KB=500
MAX_PHOTO_WIDTH=1280
MAX_PHOTO_HEIGHT=960

# Opsional: timeout & nama app
API_TIMEOUT_SECONDS=15
APP_NAME=Parkir Getter
